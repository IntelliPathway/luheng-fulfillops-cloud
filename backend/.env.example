APP_ENV=development
DATABASE_URL=postgresql+psycopg://luheng:luheng@localhost:5432/luheng
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:4177,http://localhost:5173
ALLOW_DEV_HEADER_AUTH=true
ALLOW_DEV_TOKEN=true
AUTH_MODE=development
AUTH_JWT_SECRET=replace-with-a-long-random-secret
OIDC_ISSUER=luheng-local
OIDC_AUDIENCE=luheng-fulfillops
# 生产企业身份示例：
# AUTH_MODE=oidc
# ALLOW_DEV_HEADER_AUTH=false
# ALLOW_DEV_TOKEN=false
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC_REQUIRED_CLAIMS=sub,exp,iat,jti
# OIDC_TENANT_CLAIM=tenant_ids
# OIDC_LEEWAY_SECONDS=30
# OIDC_JWKS_CACHE_SECONDS=300
# OIDC_JWKS_TIMEOUT_SECONDS=5
# OIDC_ALLOW_INSECURE_JWKS=false  # 仅封闭本地测试网络可显式开启
RUNTIME_JWT_SECRET=replace-with-a-separate-long-random-secret
JOB_EXECUTION_MODE=inline
JOB_LEASE_SECONDS=60
WORKER_STALE_SECONDS=30
WORKER_POLL_SECONDS=1
JOB_BROKER_BACKEND=database
JOB_BROKER_CHANNEL=luheng_jobs
# 独立 Worker 部署时设置固定实例标识；本地 inline 模式无需配置：
# WORKER_ID=fulfillops-worker-1
SECRET_STORE_BACKEND=reference-only
# local-envelope 使用 URL-safe Base64 编码的 32 字节主密钥；生产环境应由 KMS 注入：
# SECRET_MASTER_KEY=
# SECRET_MASTER_KEY_VERSION=v1
# SECRET_PREVIOUS_KEYS={"v0":"<old-base64-key>"}
# aws-secrets-manager 将密钥保存在 AWS，不写入应用数据库；推荐使用实例/工作负载角色：
# AWS_REGION=ap-southeast-1
# AWS_SECRET_PREFIX=luheng/fulfillops
# AWS_KMS_KEY_ID=alias/luheng-fulfillops
# AWS_SECRETS_MANAGER_ENDPOINT=  # 仅 LocalStack 等受控测试环境使用
# 真实模型出网默认关闭；启用后仍需租户配置选择 live-provider、密钥可解析且管理员确认：
ENABLE_LIVE_MODEL_CALLS=false
MODEL_EGRESS_ALLOWLIST=api.deepseek.com
MODEL_ALLOWED_MODELS=deepseek-flash,deepseek-v4-pro
MODEL_MAX_COST_USD_PER_CALL=0.25
MODEL_COST_CEILING_USD_PER_M_TOKENS=20
# 支付回执仅接受 HMAC-SHA256 v1；生产密钥由正式密钥后端注入：
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
ENABLE_PAYMENT_SANDBOX=false
# PAYMENT_SANDBOX_SECRET=local-development-only
# 仅受控本地/企业网络测试可显式开启，生产公网不得启用：
# MODEL_ALLOW_INSECURE_HTTP=false
# MODEL_ALLOW_PRIVATE_EGRESS=false
FULFILLOPS_ENABLE_DSH_RUNTIME=false
FULFILLOPS_INTERNAL_URL=http://127.0.0.1:8000
FULFILLOPS_DSH_ROOT=/tmp/luheng-fulfillops-dsh
# 真实 Harness 模式由 KMS/运行环境注入，不要提交实际值：
# DEEPSEEK_API_KEY=replace-at-deploy-time
