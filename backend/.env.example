DATABASE_URL=postgresql+psycopg://luheng:luheng@localhost:5432/luheng
CORS_ORIGINS=http://localhost:4177,http://localhost:5173
ALLOW_DEV_HEADER_AUTH=true
ALLOW_DEV_TOKEN=true
AUTH_JWT_SECRET=replace-with-a-long-random-secret
OIDC_ISSUER=luheng-local
OIDC_AUDIENCE=luheng-fulfillops
RUNTIME_JWT_SECRET=replace-with-a-separate-long-random-secret
JOB_EXECUTION_MODE=inline
JOB_LEASE_SECONDS=60
WORKER_STALE_SECONDS=30
WORKER_POLL_SECONDS=1
JOB_BROKER_BACKEND=database
JOB_BROKER_CHANNEL=luheng_jobs
# 独立 Worker 部署时设置固定实例标识；本地 inline 模式无需配置：
# WORKER_ID=fulfillops-worker-1
SECRET_STORE_BACKEND=reference-only
# local-envelope 使用 URL-safe Base64 编码的 32 字节主密钥；生产环境应由 KMS 注入：
# SECRET_MASTER_KEY=
# SECRET_MASTER_KEY_VERSION=v1
# SECRET_PREVIOUS_KEYS={"v0":"<old-base64-key>"}
FULFILLOPS_ENABLE_DSH_RUNTIME=false
FULFILLOPS_INTERNAL_URL=http://127.0.0.1:8000
FULFILLOPS_DSH_ROOT=/tmp/luheng-fulfillops-dsh
# 真实 Harness 模式由 KMS/运行环境注入，不要提交实际值：
# DEEPSEEK_API_KEY=replace-at-deploy-time
# 生产 OIDC 可追加：OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
