# 1Panel 外网验收档。先复制为 .env，再替换所有 CHANGE_ME。
APP_HTTP_PORT=18080
POSTGRES_DB=luheng
POSTGRES_USER=luheng
# 只使用字母、数字、下划线或连字符，避免 DATABASE_URL 编码不一致。
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://luheng:CHANGE_ME_DB_PASSWORD@postgres:5432/luheng

# 外网验收必须同时在 1Panel 网站层启用访问密码或 IP 白名单。
AUTH_MODE=development
ALLOW_DEV_HEADER_AUTH=true
ALLOW_DEV_TOKEN=true
AUTH_JWT_SECRET=CHANGE_ME_RANDOM_48_CHARS
RUNTIME_JWT_SECRET=CHANGE_ME_DIFFERENT_RANDOM_48_CHARS
OIDC_ISSUER=luheng-ecs-acceptance
OIDC_AUDIENCE=luheng-fulfillops
CORS_ORIGINS=https://fulfillops.example.com

# URL-safe Base64 编码的 32 字节密钥，可用：openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
SECRET_MASTER_KEY=CHANGE_ME_URLSAFE_BASE64_32_BYTES
SECRET_MASTER_KEY_VERSION=ecs-v1

# 验收环境默认不调用真实模型、不运行 Harness、不接收模拟支付。
ENABLE_LIVE_MODEL_CALLS=false
FULFILLOPS_ENABLE_DSH_RUNTIME=false
INSTALL_HARNESS=false
INSTALL_AWS=false
ENABLE_PAYMENT_SANDBOX=false
DEEPSEEK_API_KEY=
PAYMENT_SANDBOX_SECRET=
